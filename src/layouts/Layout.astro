---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        
        <!-- SEO y Meta Tags -->
        <title>{title || "Ángel Medina | Ingeniería Web y Landing Pages"}</title>
        <meta name="description" content="Landing pages ultrarrápidas y desarrollo web a la medida. Escala tu negocio con software profesional y optimizado para ventas." />
        
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    </head>
    <body class="m-0 w-full min-h-screen bg-[#0B1120] font-sans antialiased text-slate-300 selection:bg-blue-500 selection:text-white">
        <slot />
        <Analytics />
    </body>
</html>

<style is:global>
    body { font-family: 'Inter', sans-serif; }
    
    /* Efecto de cristal y bordes premium */
    .glass-card {
        background: rgba(30, 41, 59, 0.7);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(59, 130, 246, 0.2);
    }

    /* Animaciones chidas */
    .fade-up {
        animation: fadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    
    @keyframes fadeUp {
        0% { opacity: 0; transform: translateY(40px); }
        100% { opacity: 1; transform: translateY(0); }
    }
</style>