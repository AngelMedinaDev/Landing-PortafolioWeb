---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	ogImageAlt?: string;
	ogType?: 'website' | 'article';
	canonicalPath?: string;
	noindex?: boolean;
	jsonLd?: Record<string, unknown>;
}

const siteOrigin = Astro.site ?? new URL('https://angelmedinarivas.dev');
const {
	title = 'Ángel Medina | Desarrollo Web y Landing Pages en Monterrey',
	description = 'Desarrollador web en Monterrey con servicio remoto en México. Diseño y desarrollo landing pages y sitios web a medida enfocados en atraer clientes para negocios locales y empresas.',
	ogImage = '/og-image.jpg',
	ogImageAlt = 'Ángel Medina - Desarrollo web y landing pages a medida en Monterrey y México',
	ogType = 'website',
	canonicalPath = Astro.url.pathname,
	noindex = false,
	jsonLd,
} = Astro.props;

const canonicalURL = new URL(canonicalPath, siteOrigin).toString();
const ogImageURL = new URL(ogImage, siteOrigin).toString();
---

<!doctype html>
<html lang="es-MX">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#0B1120" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="canonical" href={canonicalURL} />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<!-- Open Graph -->
		<meta property="og:locale" content="es_MX" />
		<meta property="og:site_name" content="Ángel Medina" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:alt" content={ogImageAlt} />

		<!-- Twitter / X Cards -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<!-- Tipografía -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>

		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
	</head>
	<body class="m-0 w-full min-h-screen bg-[#0B1120] font-sans antialiased text-slate-300 selection:bg-blue-500 selection:text-white">
		<slot />
		<Analytics />
	</body>
</html>
