---
import { FAQ_ITEMS } from '../data/site';
---

<section
	id="preguntas"
	class="border-t border-slate-800/70 bg-[#0F172A] px-4 py-20 sm:px-6 sm:py-24"
>
	<div class="mx-auto max-w-4xl">
		<div class="text-center">
			<p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-400">
				Dudas comunes
			</p>
			<h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl">
				Preguntas frecuentes
			</h2>
			<p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-slate-400 sm:text-lg">
				Respuestas claras sobre cobertura, requisitos, dominio y cómo se cotiza cada
				proyecto.
			</p>
		</div>

		<div class="mt-12 space-y-3.5">
			{
				FAQ_ITEMS.map((item, index) => (
					<details
						open={index === 0}
						class="group rounded-2xl border border-slate-800 bg-[#111C31]/80 transition-colors open:border-blue-500/40"
					>
						<summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left text-base font-semibold text-white transition-colors hover:text-blue-200 sm:px-6 sm:py-5">
							<span>{item.question}</span>
							<svg
								class="h-5 w-5 shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180 group-open:text-blue-400"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="m6 9 6 6 6-6" />
							</svg>
						</summary>
						<div class="border-t border-slate-800/80 px-5 pb-5 pt-4 text-sm leading-relaxed text-slate-300 sm:px-6 sm:text-base">
							{item.answer}
						</div>
					</details>
				))
			}
		</div>
	</div>
</section>
