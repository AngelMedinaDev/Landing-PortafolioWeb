---
import { getWhatsAppUrl } from '../data/site';

const whatsappHref = getWhatsAppUrl();
---

<section
	id="inicio"
	class="relative overflow-hidden bg-gradient-to-b from-[#0B1120] via-[#0D1528] to-[#0F172A] px-4 pb-16 pt-12 sm:px-6 sm:pb-24 sm:pt-20 lg:pb-28 lg:pt-24"
>
	<div
		aria-hidden="true"
		class="bg-grid-subtle pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_at_center,black_30%,transparent_75%)]"
	></div>
	<div
		aria-hidden="true"
		class="pointer-events-none absolute left-1/2 top-8 h-[340px] w-[340px] -translate-x-1/2 rounded-full bg-blue-600/18 blur-[110px] sm:h-[520px] sm:w-[580px]"
	></div>

	<div class="relative z-10 mx-auto max-w-4xl text-center">
		<p
			class="mb-6 inline-flex max-w-full items-center justify-center gap-2 rounded-2xl border border-blue-500/30 bg-blue-500/10 px-3.5 py-2 text-left text-xs font-medium leading-snug text-blue-300 sm:rounded-full sm:px-4 sm:py-1.5 sm:text-center sm:text-sm"
		>
			<span class="h-2 w-2 shrink-0 rounded-full bg-blue-400" aria-hidden="true"></span>
			<span>Desarrollo Web en Monterrey · Servicio remoto en todo México</span>
		</p>

		<h1 class="mx-auto max-w-4xl text-[2rem] font-extrabold leading-[1.14] tracking-tight text-white sm:text-5xl lg:text-6xl">
			Landing pages y sitios web diseñados para{' '}
			<span class="bg-gradient-to-r from-blue-400 via-sky-400 to-blue-500 bg-clip-text text-transparent">
				atraer clientes a tu negocio
			</span>
		</h1>

		<p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-slate-300 sm:text-lg lg:text-xl">
			Diseño y desarrollo páginas web a medida, rápidas y claras para clínicas, dentistas,
			constructoras, empresas de impermeabilización, servicios especializados y PyMEs. Pensadas
			para convertir visitas en citas y cotizaciones reales.
		</p>

		<div class="mt-9 flex flex-col items-stretch justify-center gap-3.5 sm:flex-row sm:items-center sm:gap-4">
			<a
				href={whatsappHref}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center justify-center gap-2.5 rounded-full bg-blue-600 px-6 py-4 text-sm font-bold text-white shadow-lg shadow-blue-600/25 transition-all hover:-translate-y-0.5 hover:bg-blue-500 hover:shadow-blue-500/35 sm:px-8 sm:text-base"
			>
				<svg
					viewBox="0 0 32 32"
					class="h-5 w-5 shrink-0"
					fill="currentColor"
					aria-hidden="true"
				>
					<path
						d="M16 .396C7.163.396 0 7.56 0 16.396c0 2.89.756 5.6 2.078 7.96L.26 31.604l7.417-1.94A15.944 15.944 0 0016 32c8.837 0 16-7.163 16-16S24.837.396 16 .396zm0 29.07a13.01 13.01 0 01-6.63-1.83l-.475-.282-4.4 1.15 1.17-4.29-.31-.44a13.01 13.01 0 01-2.02-6.98C3.335 9.07 9.07 3.335 16 3.335S28.665 9.07 28.665 16 22.93 29.466 16 29.466zm7.36-9.73c-.4-.2-2.36-1.17-2.72-1.3-.36-.13-.62-.2-.88.2s-1 1.3-1.22 1.56c-.22.26-.44.3-.84.1s-1.7-.62-3.23-1.98c-1.2-1.06-2-2.36-2.24-2.76-.23-.4-.02-.62.18-.82.18-.18.4-.46.6-.7.2-.24.26-.4.4-.66.13-.26.07-.48-.03-.68s-.88-2.12-1.2-2.9c-.32-.77-.64-.66-.88-.67h-.75c-.26 0-.68.1-1.04.48-.36.4-1.36 1.33-1.36 3.23s1.4 3.74 1.6 4c.2.26 2.76 4.22 6.7 5.92.94.4 1.67.64 2.24.82.94.3 1.8.26 2.48.16.76-.12 2.36-.96 2.7-1.9.34-.94.34-1.74.24-1.9-.1-.16-.36-.26-.76-.46z"
					></path>
				</svg>
				<span>Cotizar mi página por WhatsApp</span>
			</a>

			<a
				href="#proyectos"
				class="inline-flex items-center justify-center gap-2 rounded-full border border-slate-700 bg-slate-900/70 px-6 py-4 text-sm font-semibold text-slate-100 transition-all hover:border-slate-500 hover:bg-slate-800/80 sm:px-8 sm:text-base"
			>
				<span>Ver proyectos</span>
				<svg
					class="h-4 w-4 shrink-0"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M12 5v14"></path>
					<path d="m19 12-7 7-7-7"></path>
				</svg>
			</a>
		</div>

		<p class="mt-6 text-xs font-medium tracking-wide text-slate-400 sm:text-sm">
			Trato directo conmigo · Cotización clara · Diseño a medida
		</p>
	</div>
</section>
