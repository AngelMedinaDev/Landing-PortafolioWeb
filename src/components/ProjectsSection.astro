---
import { Picture } from 'astro:assets';
import { PROJECTS, type ProjectItem } from '../data/site';

const badgeStyles: Record<ProjectItem['badgeTone'], string> = {
	emerald: 'border-emerald-500/30 bg-emerald-500/10 text-emerald-300',
	blue: 'border-blue-500/30 bg-blue-500/10 text-blue-300',
	amber: 'border-amber-500/30 bg-amber-500/10 text-amber-200',
};
---

<section id="proyectos" class="bg-[#0B1120] px-4 py-20 sm:px-6 sm:py-24">
	<div class="mx-auto max-w-6xl">
		<div class="mx-auto max-w-3xl text-center">
			<p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-400">
				Portafolio y soluciones
			</p>
			<h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl">
				Proyectos y soluciones por sector
			</h2>
			<p class="mt-4 text-base leading-relaxed text-slate-400 sm:text-lg">
				Un sitio actualmente en operación, una propuesta funcional para el sector dental y un
				proyecto desarrollado en revisión previa a su publicación.
			</p>
		</div>

		<div class="mt-14 grid grid-cols-1 gap-8 lg:grid-cols-3 lg:gap-7">
			{
				PROJECTS.map((project) => (
					<article class="group flex flex-col rounded-2xl border border-slate-800/90 bg-[#101A2F]/80 p-5 shadow-xl shadow-black/25 transition-all duration-300 hover:-translate-y-1 hover:border-blue-500/40 sm:p-6">
						<!-- Mockup Desktop + Móvil -->
						<div class="relative mb-9 mt-1">
							<div class="relative z-10 w-[86%] shadow-2xl shadow-black/50 transition-transform duration-500 group-hover:-translate-y-1.5">
								<div
									aria-hidden="true"
									class="flex items-center gap-1.5 rounded-t-lg border-x border-t border-slate-700/90 bg-[#1E293B] px-3 py-2"
								>
									<span class="h-2.5 w-2.5 rounded-full bg-slate-500/90" />
									<span class="h-2.5 w-2.5 rounded-full bg-slate-500/90" />
									<span class="h-2.5 w-2.5 rounded-full bg-slate-500/90" />
								</div>
								<div class="aspect-[16/9] w-full overflow-hidden rounded-b-lg border-x border-b border-slate-700/90 bg-slate-950">
									<Picture
										src={project.desktopImage}
										alt={project.desktopAlt}
										formats={['avif', 'webp']}
										fallbackFormat="webp"
										widths={[480, 800]}
										sizes="(max-width: 1024px) 82vw, 330px"
										loading="lazy"
										decoding="async"
										class="mockup-preview-img h-full w-full object-cover"
									/>
								</div>
							</div>

							<div class="absolute -bottom-6 -right-1 z-20 w-[31%] min-w-[84px] max-w-[116px] shadow-2xl shadow-black/80 transition-transform duration-500 group-hover:-translate-x-1 group-hover:-translate-y-2.5">
								<div class="rounded-[1.35rem] border border-slate-600/90 bg-slate-800 p-1.5">
									<div class="relative aspect-[9/19] w-full overflow-hidden rounded-[1.05rem] bg-slate-950">
										<Picture
											src={project.mobileImage}
											alt={project.mobileAlt}
											formats={['avif', 'webp']}
											fallbackFormat="webp"
											widths={[220, 400]}
											sizes="(max-width: 1024px) 28vw, 116px"
											loading="lazy"
											decoding="async"
											class="mockup-preview-img h-full w-full object-cover"
										/>
									</div>
								</div>
							</div>
						</div>

						<!-- Contenido de la tarjeta -->
						<div class="flex flex-1 flex-col pt-2">
							<div class="mb-3 lg:flex lg:min-h-[3.25rem] lg:items-start">
								<span
									class={`inline-block rounded-full border px-3 py-1 text-xs font-semibold leading-snug ${badgeStyles[project.badgeTone]}`}
								>
									{project.badge}
								</span>
							</div>

							<h3 class="text-2xl font-bold text-white">{project.name}</h3>
							<p class="mt-1 text-xs font-medium uppercase tracking-wider text-slate-400">
								Giro: {project.sector}
							</p>

							<p class="mt-3 text-sm leading-relaxed text-slate-300">
								<span class="font-semibold text-white">Objetivo:</span> {project.objective}
							</p>

							<p class="mt-2.5 text-sm leading-relaxed text-slate-400">{project.description}</p>

							<ul class="mt-4 space-y-2 text-sm text-slate-300">
								{project.highlights.map((item) => (
									<li class="flex items-start gap-2">
										<svg
											class="mt-0.5 h-4 w-4 shrink-0 text-blue-400"
											viewBox="0 0 20 20"
											fill="currentColor"
											aria-hidden="true"
										>
											<path
												fill-rule="evenodd"
												d="M16.704 5.29a1 1 0 0 1 .006 1.414l-7.25 7.3a1 1 0 0 1-1.42 0l-3.75-3.776a1 1 0 1 1 1.418-1.41l3.04 3.06 6.542-6.588a1 1 0 0 1 1.414 0Z"
												clip-rule="evenodd"
											/>
										</svg>
										<span>{item}</span>
									</li>
								))}
							</ul>

							<div class="mt-auto pt-6">
								<div class="border-t border-slate-800/90 pt-5">
									<a
										href={project.url}
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex items-center gap-2 text-sm font-semibold text-blue-400 transition-colors hover:text-blue-200"
									>
										<span>{project.ctaLabel}</span>
										<span aria-hidden="true">&rarr;</span>
									</a>
								</div>
							</div>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
