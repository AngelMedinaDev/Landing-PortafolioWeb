---
import { SERVICES, SERVICE_INCLUDES, getWhatsAppUrl } from '../data/site';
---

<section
	id="servicios"
	class="border-t border-slate-800/70 bg-[#0F172A] px-4 py-20 sm:px-6 sm:py-24"
>
	<div class="mx-auto max-w-6xl">
		<div class="mx-auto max-w-3xl text-center">
			<p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-400">
				Servicios
			</p>
			<h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl">
				Soluciones web pensadas para generar clientes
			</h2>
			<p class="mt-4 text-base leading-relaxed text-slate-400 sm:text-lg">
				Elige el formato que mejor se adapta a la etapa y objetivos de tu negocio. Sin
				funciones innecesarias ni plantillas lentas.
			</p>
		</div>

		<div class="mt-14 grid grid-cols-1 gap-7 lg:grid-cols-2">
			{
				SERVICES.map((service) => (
					<article
						class={`flex flex-col rounded-2xl border p-6 transition-all duration-300 sm:p-8 ${
							service.featured
								? 'border-blue-500/45 bg-gradient-to-b from-blue-950/35 to-[#111C31]/90 shadow-xl shadow-blue-950/30 hover:border-blue-400/70'
								: 'border-slate-800 bg-[#111C31]/75 hover:border-slate-700'
						}`}
					>
						<p class="text-xs font-semibold uppercase tracking-wider text-blue-400">
							{service.eyebrow}
						</p>
						<h3 class="mt-2 text-2xl font-bold text-white sm:text-3xl">{service.title}</h3>
						<p class="mt-3 text-sm font-medium leading-relaxed text-slate-200">
							{service.idealFor}
						</p>
						<p class="mt-3 text-sm leading-relaxed text-slate-400">{service.description}</p>

						<ul class="mt-6 space-y-2.5 text-sm text-slate-300">
							{service.benefits.map((benefit) => (
								<li class="flex items-start gap-2.5">
									<svg
										class="mt-0.5 h-4 w-4 shrink-0 text-blue-400"
										viewBox="0 0 20 20"
										fill="currentColor"
										aria-hidden="true"
									>
										<path
											fill-rule="evenodd"
											d="M16.704 5.29a1 1 0 0 1 .006 1.414l-7.25 7.3a1 1 0 0 1-1.42 0l-3.75-3.776a1 1 0 1 1 1.418-1.41l3.04 3.06 6.542-6.588a1 1 0 0 1 1.414 0Z"
											clip-rule="evenodd"
										/>
									</svg>
									<span>{benefit}</span>
								</li>
							))}
						</ul>

						<div class="mt-8 pt-2">
							<a
								href={getWhatsAppUrl(service.whatsappPrompt)}
								target="_blank"
								rel="noopener noreferrer"
								class={`inline-flex w-full items-center justify-center gap-2 rounded-full px-6 py-3.5 text-sm font-bold transition-all sm:w-auto ${
									service.featured
										? 'bg-blue-600 text-white shadow-lg shadow-blue-600/20 hover:bg-blue-500'
										: 'border border-slate-700 bg-slate-900/80 text-white hover:border-blue-500/60 hover:bg-slate-800'
								}`}
							>
								<span>{service.ctaLabel}</span>
								<span aria-hidden="true">&rarr;</span>
							</a>
						</div>
					</article>
				))
			}
		</div>

		<!-- Qué incluye cada proyecto -->
		<div class="mt-10 rounded-2xl border border-slate-800/90 bg-[#0B1120]/80 p-6 sm:p-8">
			<div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
				<div>
					<h3 class="text-xl font-bold text-white sm:text-2xl">
						Qué incluye cada proyecto
					</h3>
					<p class="mt-1 text-sm text-slate-400">
						Base técnica y comercial contemplada en todos los desarrollos.
					</p>
				</div>
			</div>

			<ul class="mt-6 grid grid-cols-1 gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
				{
					SERVICE_INCLUDES.map((item) => (
						<li class="flex items-start gap-2.5 rounded-xl border border-slate-800/80 bg-slate-900/50 p-3.5 text-sm leading-relaxed text-slate-200">
							<svg
								class="mt-0.5 h-4 w-4 shrink-0 text-blue-400"
								viewBox="0 0 20 20"
								fill="currentColor"
								aria-hidden="true"
							>
								<path
									fill-rule="evenodd"
									d="M16.704 5.29a1 1 0 0 1 .006 1.414l-7.25 7.3a1 1 0 0 1-1.42 0l-3.75-3.776a1 1 0 1 1 1.418-1.41l3.04 3.06 6.542-6.588a1 1 0 0 1 1.414 0Z"
									clip-rule="evenodd"
								/>
							</svg>
							<span>{item}</span>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
