---
import { CONTACT, NAV_LINKS, getMailtoUrl, getWhatsAppUrl } from '../data/site';

const whatsappHref = getWhatsAppUrl();
const mailtoHref = getMailtoUrl();
---

<footer class="border-t border-slate-800/80 bg-gradient-to-b from-[#0F172A] via-[#0B1120] to-[#060913] px-4 pb-24 pt-20 sm:px-6 sm:pb-16 sm:pt-24">
	<div class="mx-auto max-w-4xl">
		<div class="glass-card relative overflow-hidden rounded-3xl border border-blue-500/25 p-6 text-center shadow-2xl shadow-black/40 sm:p-10 md:p-14">
			<div
				aria-hidden="true"
				class="pointer-events-none absolute -top-24 left-1/2 h-56 w-80 -translate-x-1/2 rounded-full bg-blue-600/20 blur-[90px]"
			></div>

			<div class="relative z-10">
				<p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-400">
					Hablemos de tu proyecto
				</p>
				<h2 class="mt-3 text-2xl font-bold tracking-tight text-white sm:text-4xl">
					¿Listo para tener una página web que represente bien a tu negocio?
				</h2>
				<p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-slate-300 sm:text-lg">
					Cuéntame tu giro y qué necesitas lograr con tu sitio. Te respondo directamente para
					revisar el alcance y prepararte una cotización clara.
				</p>

				<div class="mt-8 flex flex-col items-stretch justify-center gap-3.5 sm:flex-row sm:items-center sm:gap-4">
					<a
						href={whatsappHref}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full bg-white px-4 py-3.5 text-[13px] font-bold text-slate-950 shadow-lg transition-all hover:-translate-y-0.5 hover:bg-slate-100 sm:gap-2.5 sm:px-8 sm:py-4 sm:text-base"
					>
						<svg
							viewBox="0 0 32 32"
							class="h-4 w-4 shrink-0 text-emerald-600 sm:h-5 sm:w-5"
							fill="currentColor"
							aria-hidden="true"
						>
							<path
								d="M16 .396C7.163.396 0 7.56 0 16.396c0 2.89.756 5.6 2.078 7.96L.26 31.604l7.417-1.94A15.944 15.944 0 0016 32c8.837 0 16-7.163 16-16S24.837.396 16 .396zm0 29.07a13.01 13.01 0 01-6.63-1.83l-.475-.282-4.4 1.15 1.17-4.29-.31-.44a13.01 13.01 0 01-2.02-6.98C3.335 9.07 9.07 3.335 16 3.335S28.665 9.07 28.665 16 22.93 29.466 16 29.466zm7.36-9.73c-.4-.2-2.36-1.17-2.72-1.3-.36-.13-.62-.2-.88.2s-1 1.3-1.22 1.56c-.22.26-.44.3-.84.1s-1.7-.62-3.23-1.98c-1.2-1.06-2-2.36-2.24-2.76-.23-.4-.02-.62.18-.82.18-.18.4-.46.6-.7.2-.24.26-.4.4-.66.13-.26.07-.48-.03-.68s-.88-2.12-1.2-2.9c-.32-.77-.64-.66-.88-.67h-.75c-.26 0-.68.1-1.04.48-.36.4-1.36 1.33-1.36 3.23s1.4 3.74 1.6 4c.2.26 2.76 4.22 6.7 5.92.94.4 1.67.64 2.24.82.94.3 1.8.26 2.48.16.76-.12 2.36-.96 2.7-1.9.34-.94.34-1.74.24-1.9-.1-.16-.36-.26-.76-.46z"
							></path>
						</svg>
						<span>Cotizar mi página por WhatsApp</span>
					</a>

					<a
						href={mailtoHref}
						class="inline-flex items-center justify-center rounded-full border border-slate-600/80 bg-slate-900/70 px-6 py-4 text-sm font-semibold text-slate-100 transition-colors hover:border-blue-400 hover:text-white sm:px-7 sm:text-base"
					>
						{CONTACT.email}
					</a>
				</div>

				<div class="mt-4 flex items-center justify-center gap-2 text-xs text-slate-400">
					<button
						type="button"
						id="copy-email-btn"
						data-email={CONTACT.email}
						class="inline-flex items-center gap-1.5 rounded-md px-2.5 py-1 font-medium text-slate-300 underline decoration-slate-600 underline-offset-4 transition-colors hover:text-white hover:decoration-blue-400"
					>
						<span id="copy-email-label">Copiar correo electrónico</span>
					</button>
					<span id="copy-email-status" class="sr-only" aria-live="polite"></span>
				</div>
			</div>
		</div>

		<div class="mt-14 flex flex-col items-center justify-between gap-6 border-t border-slate-800/80 pt-8 text-center md:flex-row md:text-left">
			<div>
				<p class="text-base font-extrabold tracking-tight text-white">
					{CONTACT.brandFirst}<span class="text-blue-500">{CONTACT.brandSecond}</span>
				</p>
				<p class="mt-1 text-sm text-slate-300">{CONTACT.locationLabel}</p>
			</div>

			<nav aria-label="Navegación de pie de página" class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
				{
					NAV_LINKS.map((link) => (
						<a
							href={link.href}
							class="text-sm text-slate-400 transition-colors hover:text-white"
						>
							{link.label}
						</a>
					))
				}
			</nav>
		</div>

		<p class="mt-8 text-center text-xs text-slate-400 md:text-left">
			&copy; 2026 {CONTACT.fullName}. Desarrollo web a la medida.
		</p>
	</div>
</footer>

<script>
	const copyBtn = document.getElementById('copy-email-btn');
	const copyLabel = document.getElementById('copy-email-label');
	const copyStatus = document.getElementById('copy-email-status');

	if (copyBtn && copyLabel && copyStatus) {
		copyBtn.addEventListener('click', async () => {
			const email = copyBtn.getAttribute('data-email');
			if (!email) return;

			try {
				await navigator.clipboard.writeText(email);
				copyLabel.textContent = 'Correo copiado al portapapeles';
				copyStatus.textContent = 'Correo copiado al portapapeles';

				window.setTimeout(() => {
					copyLabel.textContent = 'Copiar correo electrónico';
					copyStatus.textContent = '';
				}, 2200);
			} catch {
				copyLabel.textContent = email;
				copyStatus.textContent = `Correo: ${email}`;
			}
		});
	}
</script>
