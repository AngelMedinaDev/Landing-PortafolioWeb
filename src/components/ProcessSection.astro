---
import { PROCESS_STEPS } from '../data/site';
---

<section
	id="proceso"
	class="border-t border-slate-800/70 bg-[#0B1120] px-4 py-20 sm:px-6 sm:py-24"
>
	<div class="mx-auto max-w-6xl">
		<div class="mx-auto max-w-3xl text-center">
			<p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-400">
				Proceso de trabajo
			</p>
			<h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl">
				Cómo trabajamos
			</h2>
			<p class="mt-4 text-base leading-relaxed text-slate-400 sm:text-lg">
				Un proceso claro en tres etapas para que sepas en todo momento qué sigue y cómo
				avanza tu sitio web.
			</p>
		</div>

		<ol class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-3 md:gap-7">
			{
				PROCESS_STEPS.map((step) => (
					<li class="glass-card group relative overflow-hidden rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1 hover:border-blue-500/45 sm:p-8">
						<span
							aria-hidden="true"
							class="pointer-events-none absolute -right-1 -top-3 select-none text-6xl font-black text-blue-500/15 transition-transform duration-300 group-hover:scale-105"
						>
							{step.number}
						</span>
						<span class="inline-flex rounded-md border border-blue-500/30 bg-blue-500/10 px-2.5 py-1 text-xs font-bold tracking-wider text-blue-300">
							Paso {step.number}
						</span>
						<h3 class="mt-4 text-xl font-bold text-white">{step.title}</h3>
						<p class="mt-3 text-sm leading-relaxed text-slate-300">{step.description}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>
