---
---

<!doctype html>
<html lang="es">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Configuración | Precios</title>
	<script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 text-slate-800 font-sans min-h-screen">
	<header class="bg-blue-600 text-white shadow-md p-4 flex justify-between items-center">
		<h1 class="text-2xl font-bold tracking-tight">Aluminios Pro</h1>
		<a href="/cotizador" class="text-blue-200 hover:text-white font-medium">← Volver al Cotizador</a>
	</header>

	<main class="max-w-xl mx-auto p-4 mt-6">
		<div class="bg-white rounded-xl shadow-lg p-6 border-t-4 border-gray-600">
			<h2 class="text-2xl font-bold mb-6 text-gray-800">Precios y Configuración</h2>
			
			<form id="config-form" class="space-y-4">
				<div class="bg-blue-50 p-4 rounded-lg mb-6 border border-blue-100">
					<label class="block text-sm font-bold text-blue-900 mb-1">Multiplicador Base (Ej. 2.5)</label>
					<input type="number" id="cfg-factor" step="0.1" class="w-full p-2 border border-blue-300 rounded font-bold text-lg" required>
				</div>

				<h3 class="font-bold text-gray-700 border-b pb-2">Precios Unitarios</h3>
				<div class="grid grid-cols-2 gap-4">
					<div><label class="text-sm font-bold text-gray-600">Riel</label><input type="number" id="cfg-riel" class="w-full p-2 border rounded"></div>
					<div><label class="text-sm font-bold text-gray-600">Jamba</label><input type="number" id="cfg-jamba" class="w-full p-2 border rounded"></div>
					<div><label class="text-sm font-bold text-gray-600">Zoclo</label><input type="number" id="cfg-zoclo" class="w-full p-2 border rounded"></div>
					<div><label class="text-sm font-bold text-gray-600">Cerco Fijo</label><input type="number" id="cfg-cercoFijo" class="w-full p-2 border rounded"></div>
					<div><label class="text-sm font-bold text-gray-600">Traslape</label><input type="number" id="cfg-traslape" class="w-full p-2 border rounded"></div>
					<div><label class="text-sm font-bold text-gray-600">Cerco Chapa</label><input type="number" id="cfg-cercoChapa" class="w-full p-2 border rounded"></div>
					<div><label class="text-sm font-bold text-gray-600">Mosquitero</label><input type="number" id="cfg-mosquitero" class="w-full p-2 border rounded"></div>
					<div><label class="text-sm font-bold text-gray-600">Vidrio</label><input type="number" id="cfg-vidrio" class="w-full p-2 border rounded"></div>
				</div>
				<div class="mt-4">
					<label class="text-sm font-bold text-gray-600">Herrajes (Costo fijo)</label>
					<input type="number" id="cfg-herrajes" class="w-full p-2 border rounded">
				</div>

				<button type="submit" class="w-full bg-gray-800 hover:bg-black text-white font-bold py-3 px-4 rounded mt-6 shadow-md">
					Guardar Precios
				</button>
				<p id="save-msg" class="text-green-600 text-center text-sm font-bold hidden mt-2">¡Precios actualizados!</p>
			</form>
		</div>
	</main>

	<script>
		const configDefault = { riel: 50, jamba: 50, zoclo: 50, cercoFijo: 50, traslape: 50, cercoChapa: 50, mosquitero: 50, vidrio: 50, herrajes: 5, factor: 2.5 };

		function cargarDatos() {
			const guardado = localStorage.getItem('preciosAluminio');
			const cfg = guardado ? JSON.parse(guardado) : configDefault;
			
			['factor', 'riel', 'jamba', 'zoclo', 'cercoFijo', 'traslape', 'cercoChapa', 'mosquitero', 'vidrio', 'herrajes'].forEach(id => {
				document.getElementById(`cfg-${id}`).value = cfg[id];
			});
		}

		document.getElementById('config-form').addEventListener('submit', (e) => {
			e.preventDefault();
			const nuevaConfig = {};
			['factor', 'riel', 'jamba', 'zoclo', 'cercoFijo', 'traslape', 'cercoChapa', 'mosquitero', 'vidrio', 'herrajes'].forEach(id => {
				nuevaConfig[id] = parseFloat(document.getElementById(`cfg-${id}`).value) || 0;
			});

			localStorage.setItem('preciosAluminio', JSON.stringify(nuevaConfig));
			
			const msg = document.getElementById('save-msg');
			msg.classList.remove('hidden');
			setTimeout(() => msg.classList.add('hidden'), 2500);
		});

		window.addEventListener('DOMContentLoaded', cargarDatos);
	</script>
</body>
</html>