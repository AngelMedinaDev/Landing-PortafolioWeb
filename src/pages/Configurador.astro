---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Configuración | Precios">
	<!-- Igual aquí, fondo blanco absoluto para tapar el dark mode de tu Layout -->
	<div class="min-h-screen bg-slate-100 text-slate-800 font-sans absolute top-0 left-0 w-full z-50">
		<header class="bg-blue-600 text-white shadow-md p-4 flex justify-between items-center relative z-50">
			<h1 class="text-2xl font-bold tracking-tight m-0 text-white">Aluminios Pro</h1>
			<a href="/Cotizador" class="text-blue-200 hover:text-white font-medium no-underline">← Volver al Cotizador</a>
		</header>

		<main class="max-w-xl mx-auto p-4 mt-6 relative z-50">
			<div class="bg-white rounded-xl shadow-lg p-6 border-t-4 border-gray-600">
				<h2 class="text-2xl font-bold mb-6 text-gray-800">Precios y Configuración</h2>
				
				<form id="config-form" class="space-y-4">
					<div class="bg-blue-50 p-4 rounded-lg mb-6 border border-blue-100">
						<label class="block text-sm font-bold text-blue-900 mb-1">Multiplicador Base (Ej. 2.5)</label>
						<input type="number" id="cfg-factor" step="0.1" class="w-full p-2 border border-blue-300 rounded font-bold text-lg text-gray-800" required>
					</div>

					<h3 class="font-bold text-gray-700 border-b border-gray-200 pb-2 m-0 mt-4">Precios Unitarios</h3>
					<div class="grid grid-cols-2 gap-4">
						<div><label class="text-sm font-bold text-gray-600 block mb-1">Riel</label><input type="number" id="cfg-riel" class="w-full p-2 border border-gray-300 rounded text-gray-800"></div>
						<div><label class="text-sm font-bold text-gray-600 block mb-1">Jamba</label><input type="number" id="cfg-jamba" class="w-full p-2 border border-gray-300 rounded text-gray-800"></div>
						<div><label class="text-sm font-bold text-gray-600 block mb-1">Zoclo</label><input type="number" id="cfg-zoclo" class="w-full p-2 border border-gray-300 rounded text-gray-800"></div>
						<div><label class="text-sm font-bold text-gray-600 block mb-1">Cerco Fijo</label><input type="number" id="cfg-cercoFijo" class="w-full p-2 border border-gray-300 rounded text-gray-800"></div>
						<div><label class="text-sm font-bold text-gray-600 block mb-1">Traslape</label><input type="number" id="cfg-traslape" class="w-full p-2 border border-gray-300 rounded text-gray-800"></div>
						<div><label class="text-sm font-bold text-gray-600 block mb-1">Cerco Chapa</label><input type="number" id="cfg-cercoChapa" class="w-full p-2 border border-gray-300 rounded text-gray-800"></div>
						<div><label class="text-sm font-bold text-gray-600 block mb-1">Mosquitero</label><input type="number" id="cfg-mosquitero" class="w-full p-2 border border-gray-300 rounded text-gray-800"></div>
						<div><label class="text-sm font-bold text-gray-600 block mb-1">Vidrio</label><input type="number" id="cfg-vidrio" class="w-full p-2 border border-gray-300 rounded text-gray-800"></div>
					</div>
					<div class="mt-4">
						<label class="text-sm font-bold text-gray-600 block mb-1">Herrajes (Costo fijo)</label>
						<input type="number" id="cfg-herrajes" class="w-full p-2 border border-gray-300 rounded text-gray-800">
					</div>

					<button type="submit" class="w-full bg-gray-800 hover:bg-black text-white font-bold py-3 px-4 rounded mt-6 shadow-md border-0 cursor-pointer transition-colors">
						Guardar Precios
					</button>
					<p id="save-msg" class="text-green-600 text-center text-sm font-bold hidden mt-2">¡Precios actualizados!</p>
				</form>
			</div>
		</main>
	</div>
</Layout>

<script is:inline>
	const configDefault = { riel: 50, jamba: 50, zoclo: 50, cercoFijo: 50, traslape: 50, cercoChapa: 50, mosquitero: 50, vidrio: 50, herrajes: 5, factor: 2.5 };

	function cargarDatos() {
		const guardado = localStorage.getItem('preciosAluminio');
		const cfg = guardado ? JSON.parse(guardado) : configDefault;
		
		['factor', 'riel', 'jamba', 'zoclo', 'cercoFijo', 'traslape', 'cercoChapa', 'mosquitero', 'vidrio', 'herrajes'].forEach(id => {
			const el = document.getElementById(`cfg-${id}`);
			if (el) el.value = cfg[id];
		});
	}

	const form = document.getElementById('config-form');
	if (form) {
		form.addEventListener('submit', (e) => {
			e.preventDefault();
			const nuevaConfig = {};
			['factor', 'riel', 'jamba', 'zoclo', 'cercoFijo', 'traslape', 'cercoChapa', 'mosquitero', 'vidrio', 'herrajes'].forEach(id => {
				const el = document.getElementById(`cfg-${id}`);
				nuevaConfig[id] = el ? (parseFloat(el.value) || 0) : 0;
			});

			localStorage.setItem('preciosAluminio', JSON.stringify(nuevaConfig));
			
			const msg = document.getElementById('save-msg');
			if (msg) {
				msg.classList.remove('hidden');
				setTimeout(() => msg.classList.add('hidden'), 2500);
			}
		});
	}

	window.addEventListener('DOMContentLoaded', cargarDatos);
</script>