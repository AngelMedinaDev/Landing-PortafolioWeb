---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Cotizador Pro">
	<div class="min-h-screen bg-slate-100 text-slate-800 p-4">
		<main class="max-w-xl mx-auto bg-white rounded-xl shadow-lg p-6">
			<h2 class="text-2xl font-bold mb-6">Cotización para Cliente</h2>
			
			<form id="cotizador-form" class="space-y-4">
				<!-- Datos del Cliente -->
				<div>
					<label class="block text-sm font-bold text-gray-700">Nombre del Cliente</label>
					<input type="text" id="cliente" class="w-full p-2 border rounded" placeholder="Ej. Juan Pérez" required>
				</div>

				<div class="grid grid-cols-2 gap-4">
					<div>
						<label class="block text-sm font-bold text-gray-700">Tipo</label>
						<select id="tipo" class="w-full p-2 border rounded">
							<option value="v2">Ventana 2"</option>
							<option value="pta3">Puerta 3"</option>
						</select>
					</div>
					<div>
						<label class="block text-sm font-bold text-gray-700">Cantidad (Piezas)</label>
						<input type="number" id="cantidad" value="1" min="1" class="w-full p-2 border rounded">
					</div>
					<div>
						<label class="block text-sm font-bold text-gray-700">Largo (m)</label>
						<input type="number" id="largo" step="0.01" class="w-full p-2 border rounded" required>
					</div>
					<div>
						<label class="block text-sm font-bold text-gray-700">Alto (m)</label>
						<input type="number" id="alto" step="0.01" class="w-full p-2 border rounded" required>
					</div>
				</div>

				<button type="submit" class="w-full bg-blue-600 text-white font-bold py-3 rounded mt-4">
					Calcular y Guardar Cotización
				</button>
			</form>

			<div class="mt-6 p-4 bg-slate-800 rounded-lg text-center hidden" id="resultado-box">
				<p class="text-white text-sm">Precio Final (x<span id="res-cant"></span> piezas):</p>
				<p class="text-4xl font-black text-green-400" id="precio-final">$0.00</p>
				
				<button id="btn-add-more" class="mt-4 bg-slate-600 text-white px-4 py-2 rounded text-sm hover:bg-slate-500">
					+ Agregar otra ventana a este cliente
				</button>
			</div>
		</main>
	</div>
</Layout>

<script is:inline>
	document.getElementById('cotizador-form').addEventListener('submit', async (e) => {
		e.preventDefault();
		
		const data = {
			cliente: document.getElementById('cliente').value,
			tipo: document.getElementById('tipo').value,
			cantidad: parseInt(document.getElementById('cantidad').value),
			largo: parseFloat(document.getElementById('largo').value),
			alto: parseFloat(document.getElementById('alto').value),
			factor: 2.5 // Este lo puedes sacar de la sesión del usuario después
		};

		// Mandamos llamar a tu API en Astro (Backend)
		const response = await fetch('/api/cotizar', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify(data)
		});

		const result = await response.json();

		if(result.success) {
			const totalConCantidad = result.precioVenta * data.cantidad;
			
			document.getElementById('resultado-box').classList.remove('hidden');
			document.getElementById('res-cant').innerText = data.cantidad;
			document.getElementById('precio-final').innerText = '$' + totalConCantidad.toLocaleString('es-MX', {minimumFractionDigits: 2});
			
			// Aquí es donde harías un segundo fetch para guardar este registro en tu base de datos Supabase
			// para que aparezca en el Dashboard del historial.
		}
	});

	document.getElementById('btn-add-more').addEventListener('click', () => {
		document.getElementById('largo').value = '';
		document.getElementById('alto').value = '';
		document.getElementById('resultado-box').classList.add('hidden');
		// Dejamos el nombre del cliente intacto para que siga cotizando al mismo
	});
</script>