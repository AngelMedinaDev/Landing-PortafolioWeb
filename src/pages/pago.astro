---
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <!-- Mismo fondo y luz de tu index para mantener la marca -->
    <main class="min-h-screen bg-gradient-to-b from-[#0B1120] to-[#0F172A] flex items-center justify-center px-6 relative overflow-hidden">
        
        <!-- Efecto de luz blur de fondo -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-blue-600/20 rounded-full blur-[120px] pointer-events-none"></div>

        <!-- Tarjeta de Pago -->
        <div class="relative z-10 w-full max-w-sm glass-card bg-[#1E293B]/80 backdrop-blur-md border border-slate-700/50 p-8 rounded-3xl shadow-2xl text-center">
            
            <div class="text-white font-bold text-xl tracking-tighter mb-8">
                ANGEL<span class="text-blue-500">MEDINA</span>
            </div>

            <div class="text-slate-400 text-sm uppercase tracking-wider mb-1 font-semibold">BBVA - TARJETA</div>
            <div class="text-white text-xl font-bold mb-6">Ángel Medina Rivas</div>
            
            <!-- Aquí ponemos tu número de tarjeta con espacios para la vista -->
            <div id="textoCuenta" class="text-3xl tracking-widest font-black text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-blue-600 mb-8">
                4152 3146 2094 8755
            </div>
            
            <!-- Botón con estado dinámico -->
            <button id="btnCopiar" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-4 px-6 rounded-xl transition-all transform hover:scale-[1.02] shadow-lg shadow-blue-500/25 flex items-center justify-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                <span id="btnTexto">Copiar Tarjeta</span>
            </button>
            
            <div class="mt-6">
                <a href="/" class="text-slate-500 hover:text-blue-400 text-sm font-medium transition-colors">
                    &larr; Volver al portafolio
                </a>
            </div>
        </div>
    </main>
</Layout>

<script>
    const btn = document.getElementById('btnCopiar');
    const btnTexto = document.getElementById('btnTexto');
    const elementoCuenta = document.getElementById('textoCuenta');

    if (btn && btnTexto && elementoCuenta) {
        // El .replace(/\s/g, '') elimina los espacios para que se copie el número seguido
        const textoCuenta = elementoCuenta.innerText.replace(/\s/g, '').trim();

        btn.addEventListener('click', async () => {
            try {
                await navigator.clipboard.writeText(textoCuenta);
                
                btn.classList.remove('bg-blue-600', 'hover:bg-blue-500', 'shadow-blue-500/25');
                btn.classList.add('bg-emerald-500', 'hover:bg-emerald-400', 'shadow-emerald-500/25');
                btnTexto.innerText = '¡Copiado!';
                
                setTimeout(() => {
                    btn.classList.remove('bg-emerald-500', 'hover:bg-emerald-400', 'shadow-emerald-500/25');
                    btn.classList.add('bg-blue-600', 'hover:bg-blue-500', 'shadow-blue-500/25');
                    btnTexto.innerText = 'Copiar Tarjeta';
                }, 2000);
                
            } catch (err) {
                console.error('Fallo al copiar: ', err);
                alert('Detalle al copiar, por favor selecciónalo manualmente.');
            }
        });
    }
</script>